<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_purchase.SupplierSelectorScreen">
        <div class="barcode-scanner-employee-screen">
            <header class="barcode-scanner-employee-header">
                <button
                    class="barcode-scanner-employee-back-button"
                    t-on-click="goBack"
                >
                    <i class="fa fa-arrow-left" />
                </button>
                <h1 class="barcode-scanner-employee-header-title">Select Supplier</h1>
                <div style="width: 48px;" />
            </header>

            <main class="barcode-scanner-employee-main">
                <div class="barcode-scanner-employee-search-box">
                    <i class="fa fa-search barcode-scanner-employee-search-icon" />
                    <input
                        type="text"
                        class="barcode-scanner-employee-search-input"
                        placeholder="Search by name or city..."
                        t-model="state.search"
                    />
                </div>

                <h2 class="barcode-scanner-employee-section-title">VENDORS</h2>

                <div class="barcode-scanner-employee-list">
                    <t t-if="state.loading">
                        <div class="text-center p-4">Loading suppliers...</div>
                    </t>
                    <t t-else="">
                        <t t-foreach="filteredSuppliers" t-as="sup" t-key="sup.id">
                            <div
                                t-att-class="state.selectedSupplier?.id === sup.id ? 'barcode-scanner-employee-card selected' : 'barcode-scanner-employee-card'"
                                t-on-click="() => this.selectSupplier(sup)"
                            >
                                <div class="barcode-scanner-employee-avatar-wrapper">
                                    <div class="barcode-scanner-employee-avatar">
                                        <t t-if="sup.image_url">
                                            <img
                                                t-att-src="sup.image_url"
                                                t-on-error="() => this.onImageError(sup)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <div
                                                class="barcode-scanner-employee-avatar-placeholder"
                                            >
                                                <t
                                                    t-esc="sup.name.charAt(0).toUpperCase()"
                                                />
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="barcode-scanner-employee-info">
                                    <span class="barcode-scanner-employee-name">
                                        <t t-esc="sup.name" />
                                    </span>
                                    <span class="barcode-scanner-employee-role">
                                        <t t-esc="sup.city || ''" />
                                    </span>
                                </div>
                                <div class="barcode-scanner-employee-status">
                                    <t t-if="state.selectedSupplier?.id === sup.id">
                                        <i
                                            class="fa fa-check-circle barcode-scanner-employee-icon-selected"
                                        />
                                    </t>
                                    <t t-else="">
                                        <i
                                            class="fa fa-chevron-right barcode-scanner-employee-icon-chevron"
                                        />
                                    </t>
                                </div>
                            </div>
                        </t>
                        <div
                            t-if="filteredSuppliers.length === 0"
                            class="text-center p-4 barcode-scanner-empty-text"
                        >
                            No suppliers found.
                        </div>
                    </t>
                </div>
            </main>

            <footer class="barcode-scanner-employee-footer">
                <button
                    t-att-class="!state.selectedSupplier ? 'barcode-scanner-employee-confirm-button disabled' : 'barcode-scanner-employee-confirm-button'"
                    t-on-click="confirmSelection"
                >
                    Confirm Supplier
                </button>
            </footer>
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_purchase.BuyerSelectorScreen">
        <div class="barcode-scanner-employee-screen">
            <header class="barcode-scanner-employee-header">
                <button
                    class="barcode-scanner-employee-back-button"
                    t-on-click="goBack"
                >
                    <i class="fa fa-arrow-left" />
                </button>
                <h1 class="barcode-scanner-employee-header-title">Select Buyer</h1>
                <div style="width: 48px;" />
            </header>

            <main class="barcode-scanner-employee-main">
                <div class="barcode-scanner-employee-search-box">
                    <i class="fa fa-search barcode-scanner-employee-search-icon" />
                    <input
                        type="text"
                        class="barcode-scanner-employee-search-input"
                        placeholder="Search by name or login..."
                        t-model="state.search"
                    />
                </div>

                <h2 class="barcode-scanner-employee-section-title">USERS</h2>

                <div class="barcode-scanner-employee-list">
                    <t t-if="state.loading">
                        <div class="text-center p-4">Loading users...</div>
                    </t>
                    <t t-else="">
                        <t t-foreach="filteredUsers" t-as="user" t-key="user.id">
                            <div
                                t-att-class="state.selectedUser?.id === user.id ? 'barcode-scanner-employee-card selected' : 'barcode-scanner-employee-card'"
                                t-on-click="() => this.selectUser(user)"
                            >
                                <div class="barcode-scanner-employee-avatar-wrapper">
                                    <div class="barcode-scanner-employee-avatar">
                                        <t t-if="user.image_url">
                                            <img
                                                t-att-src="user.image_url"
                                                t-on-error="() => this.onImageError(user)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <div
                                                class="barcode-scanner-employee-avatar-placeholder"
                                            >
                                                <t
                                                    t-esc="user.name.charAt(0).toUpperCase()"
                                                />
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="barcode-scanner-employee-info">
                                    <span class="barcode-scanner-employee-name">
                                        <t t-esc="user.name" />
                                    </span>
                                    <span class="barcode-scanner-employee-role">
                                        <t t-esc="user.login || ''" />
                                    </span>
                                </div>
                                <div class="barcode-scanner-employee-status">
                                    <t t-if="state.selectedUser?.id === user.id">
                                        <i
                                            class="fa fa-check-circle barcode-scanner-employee-icon-selected"
                                        />
                                    </t>
                                    <t t-else="">
                                        <i
                                            class="fa fa-chevron-right barcode-scanner-employee-icon-chevron"
                                        />
                                    </t>
                                </div>
                            </div>
                        </t>
                        <div
                            t-if="filteredUsers.length === 0"
                            class="text-center p-4 barcode-scanner-empty-text"
                        >
                            No users found.
                        </div>
                    </t>
                </div>
            </main>

            <footer class="barcode-scanner-employee-footer">
                <button
                    t-att-class="!state.selectedUser ? 'barcode-scanner-employee-confirm-button disabled' : 'barcode-scanner-employee-confirm-button'"
                    t-on-click="confirmSelection"
                >
                    Confirm Buyer
                </button>
            </footer>
        </div>
    </t>
</templates>

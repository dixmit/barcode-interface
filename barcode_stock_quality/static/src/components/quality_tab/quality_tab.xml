<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_stock_quality.QualityTab">
        <div class="barcode-scanner-quality-tab">
            <t t-if="!state.canInspect">
                <div class="barcode-scanner-quality-empty">
                    Only Quality Control users can run the inspections.
                </div>
            </t>
            <t t-elif="state.loading">
                <div class="barcode-scanner-quality-empty">Loading inspections…</div>
            </t>
            <t t-elif="!state.inspections.length">
                <div class="barcode-scanner-quality-empty">
                    No quality inspection for this reception.
                </div>
            </t>

            <div
                t-foreach="state.inspections"
                t-as="inspection"
                t-key="inspection.inspection_id"
                class="barcode-scanner-quality-inspection"
            >
                <div class="barcode-scanner-quality-inspection-head">
                    <div class="barcode-scanner-quality-inspection-title">
                        <t t-esc="inspection.test_name" />
                    </div>
                    <span
                        class="barcode-scanner-quality-badge"
                        t-att-class="{
                            'barcode-scanner-quality-badge-passed': inspection.state === 'success',
                            'barcode-scanner-quality-badge-failed': inspection.state === 'failed' or inspection.state === 'waiting',
                        }"
                    >
                        <t t-if="inspection.state === 'success'">Passed</t>
                        <t t-elif="inspection.state === 'failed'">Failed</t>
                        <t t-elif="inspection.state === 'waiting'">To review</t>
                        <t t-else="">Pending</t>
                    </span>
                </div>
                <div
                    class="barcode-scanner-quality-inspection-subtitle"
                    t-if="inspection.lot_name"
                >
                    <t t-esc="inspection.product_name" /> ·
                    Lot/Serial: <t t-esc="inspection.lot_name" />
                </div>
                <div class="barcode-scanner-quality-inspection-subtitle" t-else="">
                    <t t-esc="inspection.product_name" />
                </div>

                <!-- Questions (editable only while the inspection is ready) -->
                <t t-if="isEditable(inspection)">
                    <div
                        t-foreach="inspection.lines"
                        t-as="line"
                        t-key="line.id"
                        class="barcode-scanner-quality-question"
                    >
                        <div class="barcode-scanner-quality-question-name">
                            <t t-esc="line.name" />
                        </div>
                        <div
                            class="barcode-scanner-quality-question-notes"
                            t-if="line.notes"
                        >
                            <t t-esc="line.notes" />
                        </div>
                        <t t-if="line.question_type === 'qualitative'">
                            <div class="barcode-scanner-quality-choices">
                                <button
                                    t-foreach="line.possible_values"
                                    t-as="value"
                                    t-key="value.id"
                                    class="barcode-scanner-quality-choice"
                                    t-att-class="{'barcode-scanner-quality-choice-active': isChosen(inspection, line, value.id)}"
                                    t-on-click="() => this.setQualitative(inspection, line, value.id)"
                                >
                                    <t t-esc="value.name" />
                                </button>
                            </div>
                        </t>
                        <t t-if="line.question_type === 'quantitative'">
                            <div class="barcode-scanner-quality-measure">
                                <input
                                    type="number"
                                    step="any"
                                    class="barcode-scanner-quality-measure-input"
                                    t-att-value="measureOf(inspection, line)"
                                    t-on-input="(ev) => this.onQuantitative(inspection, line, ev)"
                                />
                                <span
                                    class="barcode-scanner-quality-measure-unit"
                                    t-if="line.uom_name"
                                >
                                    <t t-esc="line.uom_name" />
                                </span>
                            </div>
                        </t>
                    </div>

                    <button
                        class="barcode-scanner-quality-submit"
                        t-att-disabled="!allAnswered(inspection) or state.busyId === inspection.inspection_id"
                        t-on-click="() => this.submit(inspection)"
                    >
                        Confirm inspection
                    </button>
                </t>

                <!-- Answers of a confirmed inspection, read-only -->
                <t t-elif="isConfirmed(inspection)">
                    <div
                        t-foreach="inspection.lines"
                        t-as="line"
                        t-key="line.id"
                        class="barcode-scanner-quality-answer"
                    >
                        <i
                            t-att-class="line.success ? 'fa fa-check-circle barcode-scanner-quality-answer-passed' : 'fa fa-times-circle barcode-scanner-quality-answer-failed'"
                        />
                        <span class="barcode-scanner-quality-answer-name">
                            <t t-esc="line.name" />
                        </span>
                        <span class="barcode-scanner-quality-answer-value">
                            <t t-esc="answerLabel(line)" />
                        </span>
                    </div>
                </t>

                <!-- Photo evidence: available once there is a failure to justify -->
                <div
                    class="barcode-scanner-quality-evidence"
                    t-if="inspection.state === 'waiting' or inspection.state === 'failed'"
                >
                    <label class="barcode-scanner-quality-photo-button">
                        <i class="fa fa-camera me-1" /> Attach photo evidence
                        <input
                        type="file"
                        accept="image/*"
                        capture="environment"
                        class="barcode-scanner-quality-photo-input"
                        t-on-change="(ev) => this.onPhotoSelected(inspection, ev)"
                    />
                    </label>
                    <span
                        class="barcode-scanner-quality-photo-count"
                        t-if="inspection.photo_count"
                    >
                        <t t-esc="inspection.photo_count" /> photo(s)
                    </span>
                </div>

                <!-- Undo a wrong confirmation: back to draft to answer again -->
                <button
                    t-if="canReset(inspection)"
                    class="barcode-scanner-quality-reset"
                    t-att-disabled="state.busyId === inspection.inspection_id"
                    t-on-click="() => this.reset(inspection)"
                >
                    <i class="fa fa-undo me-1" /> Back to draft
                </button>
            </div>
        </div>
    </t>

</templates>

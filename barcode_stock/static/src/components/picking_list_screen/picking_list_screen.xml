<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.GroupRenderer">
        <t
            t-foreach="component.sortedGroupKeys(groups, level)"
            t-as="groupKey"
            t-key="groupKey"
        >
            <div class="barcode-scanner-group-wrapper">
                <t t-if="groupKey !== 'all'">
                    <div
                        class="barcode-scanner-group-header"
                        t-on-click="() => component.toggleGroup(path + '-' + groupKey)"
                    >
                        <div class="barcode-scanner-group-title-container">
                            <div class="barcode-scanner-group-indicator" />
                            <h2 class="barcode-scanner-group-title">
                                <t t-esc="component.getGroupLevelLabel(level)" />: <t
                                t-esc="groupKey"
                            />
                            </h2>
                        </div>
                        <div class="barcode-scanner-group-actions">
                            <span class="barcode-scanner-group-badge">
                                <t
                                t-esc="component.countGroupEntries(groups[groupKey])"
                            /> Items
                            </span>
                        </div>
                    </div>
                </t>

                <div
                    t-if="!component.state.collapsedGroups[path + '-' + groupKey]"
                    class="barcode-scanner-group-body"
                >
                    <t t-if="Array.isArray(groups[groupKey])">
                        <div class="barcode-scanner-picking-cards">
                            <t t-foreach="groups[groupKey]" t-as="p" t-key="p.id">
                                <article
                                    class="barcode-scanner-picking-card"
                                    t-on-click="() => component.openPicking(p.id)"
                                >
                                    <div class="barcode-scanner-picking-card-top">
                                        <div class="barcode-scanner-picking-card-info">
                                            <span class="barcode-scanner-picking-code">
                                                <t t-esc="p.name" />
                                            </span>
                                            <h3 class="barcode-scanner-picking-partner">
                                                <t
                                                    t-esc="component.getPartnerName(p)"
                                                />
                                            </h3>
                                        </div>
                                        <div
                                            class="barcode-scanner-picking-card-status-col"
                                            style="display: flex; align-items: center; gap: 4px;"
                                        >
                                            <span
                                                t-att-class="p.state === 'assigned' ? 'barcode-scanner-status-tag barcode-scanner-status-tag-ready' : 'barcode-scanner-status-tag'"
                                            >
                                                <t
                                                    t-esc="component.getStateLabel(p).toUpperCase()"
                                                />
                                            </span>
                                            <i
                                                class="fa fa-chevron-right barcode-scanner-picking-chevron"
                                            />
                                        </div>
                                    </div>

                                    <div class="barcode-scanner-divider" />

                                    <div class="barcode-scanner-picking-card-bottom">
                                        <div class="barcode-scanner-picking-meta-left">
                                            <i
                                                class="fa fa-cubes barcode-scanner-meta-icon"
                                            />
                                            <span class="barcode-scanner-meta-text">
                                                <t t-esc="component.getSkuSummary(p)" />
                                            </span>
                                        </div>

                                        <div class="barcode-scanner-picking-meta-right">
                                            <t t-if="component.isUrgentPicking(p)">
                                                <span
                                                    class="barcode-scanner-meta-text text-danger"
                                                ><i
                                                    class="fa fa-exclamation-triangle me-1"
                                                />Urgent</span>
                                            </t>
                                            <t t-else="">
                                                <i
                                                    class="fa fa-clock-o barcode-scanner-meta-icon"
                                                />
                                                <span class="barcode-scanner-meta-text">
                                                    <t
                                                        t-esc="component.getScheduleSummary(p)"
                                                    />
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </t>
                    <t t-if="!Array.isArray(groups[groupKey])">
                        <t t-call="barcode_scanner.GroupRenderer">
                            <t t-set="groups" t-value="groups[groupKey]" />
                            <t t-set="path" t-value="path + '-' + groupKey" />
                            <t t-set="level" t-value="level + 1" />
                            <t t-set="component" t-value="component" />
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </t>
    <t t-name="barcode_scanner.PickingListScreen">
        <div class="barcode-scanner-list-screen barcode-scanner-picking-list">
            <header class="barcode-scanner-header barcode-scanner-header-elevated">
                <button
                    type="button"
                    class="barcode-scanner-icon-button"
                    t-on-click="goBack"
                >
                    <i class="fa fa-arrow-left" />
                </button>
                <h1 class="barcode-scanner-header-title">Picking Operations</h1>
                <div class="header-spacer" />
            </header>

            <main class="barcode-scanner-main">
                <div class="barcode-scanner-search-section">
                    <div class="barcode-scanner-search-bar">
                        <i class="fa fa-search barcode-scanner-search-icon" />
                        <input
                            name="search"
                            type="text"
                            class="barcode-scanner-search-input"
                            placeholder="Scan or search pickings..."
                            t-model="state.search"
                        />
                    </div>

                    <div
                        class="barcode-scanner-filter-tools"
                        t-on-click.stop="() => {}"
                    >
                        <div class="barcode-scanner-filter-toolbar">
                            <button
                                type="button"
                                class="barcode-scanner-filter-tool-button"
                                t-att-class="{active: state.openMenu === 'filters', 'has-value': state.activeFilters.length}"
                                t-on-click="() => this.toggleMenu('filters')"
                            >
                                <i class="fa fa-filter" />
                                <span>Filters</span>
                                <span
                                    t-if="state.activeFilters.length"
                                    class="barcode-scanner-filter-tool-count"
                                    t-esc="state.activeFilters.length"
                                />
                                <i class="fa fa-caret-down" />
                            </button>
                            <button
                                type="button"
                                class="barcode-scanner-filter-tool-button"
                                t-att-class="{active: state.openMenu === 'group', 'has-value': state.groupByLevels.length}"
                                t-on-click="() => this.toggleMenu('group')"
                            >
                                <i class="fa fa-layer-group" />
                                <span>Group by</span>
                                <i class="fa fa-caret-down" />
                            </button>
                            <div class="barcode-scanner-filter-tool-spacer" />
                            <button
                                type="button"
                                class="barcode-scanner-filter-tool-button barcode-scanner-star-button"
                                t-att-class="{active: isCurrentFilterDefault}"
                                t-att-title="starTitle"
                                t-on-click="() => this.toggleDefaultFilter()"
                            >
                                <i
                                    t-att-class="isCurrentFilterDefault ? 'fa fa-star' : 'fa fa-star-o'"
                                />
                            </button>

                            <div
                                class="barcode-scanner-filter-menu"
                                t-if="state.openMenu === 'filters'"
                            >
                                <div class="barcode-scanner-filter-menu-section">
                                    <div
                                        class="barcode-scanner-filter-menu-title"
                                    >Quick filters</div>
                                    <button
                                        type="button"
                                        class="barcode-scanner-filter-menu-option"
                                        t-att-class="{selected: isReadyQuickActive}"
                                        t-on-click="() => this.toggleReadyQuick()"
                                    >
                                        <i
                                            class="fa"
                                            t-att-class="isReadyQuickActive ? 'fa-check-square-o' : 'fa-square-o'"
                                        />
                                        <span t-esc="readyStateLabel" />
                                    </button>
                                </div>
                                <div class="barcode-scanner-filter-menu-section">
                                    <div
                                        class="barcode-scanner-filter-menu-title"
                                    >Status</div>
                                    <button
                                        type="button"
                                        class="barcode-scanner-filter-menu-option"
                                        t-att-class="{selected: !state.activeFilters.includes('state')}"
                                        t-on-click="() => this.setStateFilter('all')"
                                    >
                                        <i
                                            class="fa"
                                            t-att-class="!state.activeFilters.includes('state') ? 'fa-dot-circle-o' : 'fa-circle-o'"
                                        />
                                        <span>All</span>
                                    </button>
                                    <t
                                        t-foreach="Object.entries(state.stateLabels)"
                                        t-as="entry"
                                        t-key="entry[0]"
                                    >
                                        <button
                                            type="button"
                                            class="barcode-scanner-filter-menu-option"
                                            t-att-class="{selected: state.activeFilters.includes('state') &amp;&amp; state.filterValues.state === entry[0]}"
                                            t-on-click="() => this.setStateFilter(entry[0])"
                                        >
                                            <i
                                                class="fa"
                                                t-att-class="(state.activeFilters.includes('state') &amp;&amp; state.filterValues.state === entry[0]) ? 'fa-dot-circle-o' : 'fa-circle-o'"
                                            />
                                            <span t-esc="entry[1]" />
                                        </button>
                                    </t>
                                </div>
                                <div class="barcode-scanner-filter-menu-section">
                                    <div
                                        class="barcode-scanner-filter-menu-title"
                                    >Date</div>
                                    <t
                                        t-foreach="dateFilterOptions"
                                        t-as="opt"
                                        t-key="opt.value || 'all'"
                                    >
                                        <button
                                            type="button"
                                            class="barcode-scanner-filter-menu-option"
                                            t-att-class="{selected: isDateOptionSelected(opt.value)}"
                                            t-on-click="() => this.setDateFilter(opt.value)"
                                        >
                                            <i
                                                class="fa"
                                                t-att-class="isDateOptionSelected(opt.value) ? 'fa-dot-circle-o' : 'fa-circle-o'"
                                            />
                                            <span t-esc="opt.label" />
                                        </button>
                                    </t>
                                    <div
                                        class="barcode-scanner-filter-menu-custom-date"
                                        t-if="state.filterValues.date &amp;&amp; state.filterValues.date.startsWith('custom:')"
                                    >
                                        <input
                                            type="date"
                                            class="barcode-scanner-filter-date-input"
                                            t-att-value="state.filterValues.date ? state.filterValues.date.substring(7) : ''"
                                            t-on-change="(ev) => this.setCustomDate(ev.target.value)"
                                        />
                                    </div>
                                </div>
                            </div>

                            <div
                                class="barcode-scanner-filter-menu"
                                t-if="state.openMenu === 'group'"
                            >
                                <div class="barcode-scanner-filter-menu-section">
                                    <div
                                        class="barcode-scanner-filter-menu-title"
                                    >Group by</div>
                                    <t
                                        t-foreach="groupOrder"
                                        t-as="group"
                                        t-key="group"
                                    >
                                        <button
                                            type="button"
                                            class="barcode-scanner-filter-menu-option"
                                            t-att-class="{selected: state.groupByLevels.includes(group)}"
                                            t-on-click="() => this.toggleGroupLevel(group)"
                                        >
                                            <i
                                                class="fa"
                                                t-att-class="state.groupByLevels.includes(group) ? 'fa-check-square-o' : 'fa-square-o'"
                                            />
                                            <span t-esc="groupLabels[group] || group" />
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div
                            class="barcode-scanner-filter-facets"
                            t-if="state.activeFilters.length || state.groupByLevels.length"
                        >
                            <t
                                t-foreach="state.activeFilters"
                                t-as="filter"
                                t-key="filter"
                            >
                                <span class="barcode-scanner-filter-facet">
                                    <span class="barcode-scanner-filter-facet-text"><t
                                        t-esc="filterLabels[filter]"
                                    />: <t
                                        t-esc="getFilterDisplayValue(filter)"
                                    /></span>
                                    <button
                                        type="button"
                                        class="barcode-scanner-filter-facet-remove"
                                        t-on-click="() => this.removeFilter(filter)"
                                    >
                                        <i class="fa fa-times" />
                                    </button>
                                </span>
                            </t>
                            <t
                                t-foreach="state.groupByLevels"
                                t-as="group"
                                t-key="group"
                            >
                                <span
                                    class="barcode-scanner-filter-facet barcode-scanner-filter-facet-group"
                                >
                                    <span class="barcode-scanner-filter-facet-text">
                                        <i class="fa fa-layer-group" />
                                        <t t-esc="groupLabels[group] || group" />
                                    </span>
                                    <button
                                        type="button"
                                        class="barcode-scanner-filter-facet-remove"
                                        t-on-click="() => this.removeGroup(group)"
                                    >
                                        <i class="fa fa-times" />
                                    </button>
                                </span>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="barcode-scanner-picking-cards">
                    <t t-if="state.loading">
                        <div class="text-center p-4">Loading queue...</div>
                    </t>
                    <t t-elif="filteredPickings.length">
                        <t t-call="barcode_scanner.GroupRenderer">
                            <t t-set="groups" t-value="state.groupedPickings" />
                            <t t-set="path" t-value="'root'" />
                            <t t-set="level" t-value="0" />
                            <t t-set="component" t-value="this" />
                        </t>
                    </t>
                    <t t-else="">
                        <div
                            class="empty-state barcode-scanner-picking-list--empty-state"
                        >
                            <div class="empty-title">No pending pickings</div>
                            <div class="empty-subtitle">
                                Adjust filters or scan a picking name to continue.
                            </div>
                        </div>
                    </t>
                </div>
            </main>
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.InternalTransferScreen">
        <div class="barcode-scanner-screen">
            <header class="barcode-scanner-screen-header">
                <button class="barcode-scanner-screen-back-button" t-on-click="goBack">
                    <i class="fa fa-arrow-left" />
                </button>
                <h1 class="barcode-scanner-screen-header-title">Internal Transfer</h1>
                <div style="width: 40px;" />
            </header>

            <div class="barcode-scanner-screen-main">
                <div class="barcode-scanner-screen-field-group">
                    <div class="barcode-scanner-screen-label">ORIGIN LOCATION</div>
                    <div
                        class="barcode-scanner-transfer-select-card"
                        t-on-click="selectOriginLocation"
                    >
                        <div class="barcode-scanner-transfer-icon">
                            <i class="fa fa-map-marker" />
                        </div>
                        <div class="barcode-scanner-transfer-text">
                            <t t-if="state.origin_location">
                                <t t-esc="state.origin_location.display_name" />
                            </t>
                            <t t-else="">Select origin</t>
                        </div>
                        <div class="barcode-scanner-transfer-chevron">
                            <i class="fa fa-chevron-down" />
                        </div>
                    </div>
                </div>

                <div class="barcode-scanner-screen-field-group">
                    <div class="barcode-scanner-screen-label">DESTINATION LOCATION</div>
                    <div
                        class="barcode-scanner-transfer-select-card"
                        t-on-click="selectDestinationLocation"
                    >
                        <div class="barcode-scanner-transfer-icon">
                            <i class="fa fa-sign-in" />
                        </div>
                        <div class="barcode-scanner-transfer-text">
                            <t t-if="state.destination_location">
                                <t t-esc="state.destination_location.display_name" />
                            </t>
                            <t t-else="">Select destination</t>
                        </div>
                        <div class="barcode-scanner-transfer-chevron">
                            <i class="fa fa-chevron-down" />
                        </div>
                    </div>
                </div>

                <div class="barcode-scanner-screen-field-group">
                    <div class="barcode-scanner-screen-label">RESPONSIBLE</div>
                    <div
                        class="barcode-scanner-transfer-select-card"
                        t-on-click="selectResponsible"
                    >
                        <div class="barcode-scanner-transfer-icon">
                            <i class="fa fa-user-o" />
                        </div>
                        <div class="barcode-scanner-transfer-text">
                            <t t-if="state.responsible">
                                <t t-esc="state.responsible.name" />
                            </t>
                            <t t-else="">Select responsible</t>
                        </div>
                        <div class="barcode-scanner-transfer-chevron">
                            <i class="fa fa-chevron-down" />
                        </div>
                    </div>
                </div>

                <div class="barcode-scanner-screen-field-group">
                    <div class="barcode-scanner-transfer-section-header">
                        <div
                            class="barcode-scanner-screen-label"
                            style="margin:0;"
                        >DETAILED OPERATIONS</div>
                        <div class="barcode-scanner-transfer-items-badge">
                            <t t-esc="state.lines.length" /> ITEM<t
                            t-if="state.lines.length !== 1"
                        >S</t>
                        </div>
                    </div>

                    <div class="barcode-scanner-transfer-lines-container">
                        <t
                            t-foreach="state.lines"
                            t-as="line"
                            t-key="line.product_id + '_' + (line.lot_id || '')"
                        >
                            <div class="barcode-scanner-transfer-line-card">
                                <button
                                    class="barcode-scanner-transfer-line-delete"
                                    t-on-click="() => this.removeLine(line)"
                                >
                                    <i class="fa fa-times" />
                                </button>
                                <div class="barcode-scanner-transfer-line-top">
                                    <div class="barcode-scanner-transfer-line-name">
                                        <t t-esc="line.product_name" />
                                    </div>
                                    <div class="barcode-scanner-transfer-quantity-pill">
                                        <input
                                            class="barcode-scanner-transfer-quantity-input"
                                            type="number"
                                            t-model="line.qty"
                                            min="1"
                                            t-att-readonly="line.tracking === 'serial'"
                                        />
                                        <span
                                            class="barcode-scanner-transfer-quantity-unit"
                                        >UNITS</span>
                                    </div>
                                </div>
                                <div class="barcode-scanner-transfer-line-lot">
                                    <t t-if="line.tracking !== 'none'">
                                        <select
                                            class="barcode-scanner-transfer-lot-select"
                                            t-model="line.lot_id"
                                            t-on-change="(ev) => this.onLotChanged(line, ev)"
                                        >
                                            <option value="">Select lot</option>
                                            <t
                                                t-foreach="line.lots"
                                                t-as="lot"
                                                t-key="lot.id"
                                            >
                                                <option t-att-value="lot.id">
                                                    <t t-esc="lot.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-tag me-1" />
                                        <t t-esc="line.lot_name || 'No lot'" />
                                    </t>
                                </div>
                                <div class="barcode-scanner-transfer-line-divider" />
                                <div
                                    class="barcode-scanner-transfer-line-bottom"
                                    style="display: flex; justify-content: space-between; align-items: center;"
                                >
                                    <span><i class="fa fa-cube" /> Reserved: <t
                                        t-esc="line.qty || '0.00'"
                                    /></span>
                                    <t t-if="line.available_qty !== undefined">
                                        <span
                                            t-att-style="line.is_available ? 'color: #16a34a; font-weight: 600;' : 'color: #dc2626; font-weight: 600;'"
                                        >
                                            <i class="fa fa-database" /> Available: <t
                                            t-esc="line.available_qty"
                                        />
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <button
                        class="barcode-scanner-screen-button-primary"
                        style="margin-top:1rem; background: #ffffff; color: #111827; border: 1px solid #e5e7eb; box-shadow: none;"
                        t-on-click="addProduct"
                    >
                        <i class="fa fa-plus" /> Add a line
                    </button>
                </div>
            </div>

            <footer
                class="barcode-scanner-screen-footer"
                style="display:flex; gap:1rem;"
            >
                <button
                    class="barcode-scanner-screen-button-primary"
                    style="background: #ffffff; color: #111827; border: 1px solid #e5e7eb; box-shadow: none;"
                    t-on-click="checkAvailability"
                    t-att-disabled="state.isCheckingAvailability or state.isValidating"
                >
                    <i class="fa fa-check-square-o" />
                    <span>CHECK</span>
                </button>
                <button
                    class="barcode-scanner-screen-button-primary"
                    t-on-click="validateTransfer"
                    t-att-disabled="state.isValidating or state.isCheckingAvailability"
                >
                    <i class="fa fa-check" />
                    <span>VALIDATE</span>
                </button>
            </footer>
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.PickingMoveCard" owl="1">
        <button
            type="button"
            class="barcode-scanner-picking-card barcode-scanner-picking-move-card"
            t-att-class="props.highlighted ? 'barcode-scanner-picking-card barcode-scanner-picking-move-card is-highlighted' : 'barcode-scanner-picking-card barcode-scanner-picking-move-card'"
            t-on-click="props.onClick"
            style="border: none; text-align: left; width: 100%; cursor: pointer;"
        >
            <div class="barcode-scanner-picking-card-top">
                <div class="barcode-scanner-picking-card-info">
                    <span class="barcode-scanner-picking-code">Scan target</span>
                    <h3 class="barcode-scanner-picking-partner mb-1">
                        <t t-esc="props.move.product_id[1]" />
                    </h3>
                </div>
                <div
                    class="barcode-scanner-picking-card-status"
                    style="align-items: center; flex-direction: row; gap: 8px;"
                >
                    <span class="barcode-scanner-group-badge">
                        <t t-esc="props.stats?.completionLabel || '0%'" />
                    </span>
                    <i
                        class="fa fa-chevron-right barcode-scanner-picking-chevron"
                        role="img"
                        aria-label="Open"
                    />
                </div>
            </div>
            <hr class="barcode-scanner-divider" />
            <div
                class="barcode-scanner-picking-card-bottom"
                style="flex-wrap: wrap; gap: 8px;"
            >
                <div class="barcode-scanner-picking-meta-left">
                    <span class="barcode-scanner-meta-text">Demand: <strong>
                        <t t-esc="demandQty" />
                    </strong></span>
                </div>
                <div class="barcode-scanner-picking-meta-right" style="gap: 16px;">
                    <span
                        class="barcode-scanner-meta-text"
                        style="color: #ff9800;"
                    >Rem: <strong>
                        <t t-esc="remainingQty" />
                    </strong></span>
                    <span
                        class="barcode-scanner-meta-text"
                        style="color: #4caf50;"
                    >Done: <strong>
                        <t t-esc="doneQty" />
                    </strong></span>
                </div>
            </div>
            <div
                class="barcode-scanner-progress-bar"
                role="progressbar"
                t-att-aria-valuenow="doneQty"
                t-att-aria-valuemin="0"
                t-att-aria-valuemax="demandQty"
                style="height: 6px; background: var(--kw-surface-low); border-radius: 3px; overflow: hidden; width: 100%; margin-top: 8px;"
            >
                <div
                    class="barcode-scanner-progress-bar-value"
                    t-att-style="`width: ${Math.min((props.stats?.completion || 0) * 100, 100)}%; height: 100%; background: var(--kw-primary-container); transition: width 0.3s;`"
                />
            </div>
            <ul
                t-if="linesForMove.length"
                class="barcode-scanner-picking-move-card-lots"
                style="list-style: none; padding: 0; margin-top: 12px; margin-bottom: 0;"
            >
                <li
                    t-foreach="linesForMove"
                    t-as="line"
                    t-key="line.id"
                    style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--kw-on-surface-variant); margin-bottom: 4px;"
                >
                    <strong>
                        <i class="fa fa-tag me-1" />
                        <t t-esc="line.lot_id ? line.lot_id[1] : 'No lot'" />
                    </strong>
                    <span>
                        <t t-esc="linePending(line)" />
                        <t t-esc="pendingLabel" />
                    </span>
                </li>
            </ul>
            <div
                t-if="props.move.lot_names and props.move.lot_names.length"
                class="barcode-scanner-picking-move-card-chips"
                style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px;"
            >
                <t t-foreach="props.move.lot_names" t-as="lot" t-key="lot">
                    <span
                        class="barcode-scanner-chip barcode-scanner-chip-default"
                        style="height: 24px; padding: 0 8px; font-size: 0.75rem;"
                    >
                        <t t-esc="lot" />
                    </span>
                </t>
            </div>
        </button>
    </t>
</templates>

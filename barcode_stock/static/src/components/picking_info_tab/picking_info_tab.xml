<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.PickingInfoTab" owl="1">
        <div class="barcode-scanner-tab-content">
            <div class="barcode-scanner-card">
                <div class="barcode-scanner-info-row">
                    <div
                        class="barcode-scanner-icon-box-small barcode-scanner-background-orange"
                    >
                        <i class="fa fa-building" />
                    </div>
                    <div class="barcode-scanner-info-text">
                        <span class="barcode-scanner-eyebrow">PARTNER</span>
                        <strong class="barcode-scanner-title">
                            <t t-esc="props.picking.partner_id?.[1] || 'No partner'" />
                        </strong>
                    </div>
                </div>
                <div class="barcode-scanner-info-row mt-3">
                    <div
                        class="barcode-scanner-icon-box-small barcode-scanner-background-purple-light"
                    >
                        <i class="fa fa-map-marker" />
                    </div>
                    <div class="barcode-scanner-info-text">
                        <span class="barcode-scanner-eyebrow">From</span>
                        <span class="barcode-scanner-value">
                            <t t-esc="props.picking.location_id?.[1]" />
                        </span>
                    </div>
                </div>
                <div class="barcode-scanner-info-row mt-3">
                    <div
                        class="barcode-scanner-icon-box-small barcode-scanner-background-purple-light"
                    >
                        <i class="fa fa-arrow-right" />
                    </div>
                    <div class="barcode-scanner-info-text">
                        <span class="barcode-scanner-eyebrow">To</span>
                        <span class="barcode-scanner-value">
                            <t t-esc="props.picking.location_dest_id?.[1]" />
                        </span>
                    </div>
                </div>
                <div
                    class="barcode-scanner-info-row mt-3"
                    t-on-click="onSelectResponsible"
                    style="cursor: pointer;"
                >
                    <div
                        class="barcode-scanner-icon-box-small barcode-scanner-background-purple-light"
                    >
                        <i class="fa fa-user" />
                    </div>
                    <div class="barcode-scanner-info-text">
                        <span class="barcode-scanner-eyebrow">Responsible</span>
                        <span class="barcode-scanner-value">
                            <t t-esc="props.picking.user_id?.[1] || 'Unassigned'" />
                        </span>
                    </div>
                    <i
                        class="fa fa-chevron-right"
                        style="color: var(--barcode-scanner-on-surface-variant); font-size: 0.8rem;"
                    />
                </div>
                <div class="barcode-scanner-info-row mt-3">
                    <div
                        class="barcode-scanner-icon-box-small barcode-scanner-background-purple-light"
                    >
                        <i class="fa fa-calendar" />
                    </div>
                    <div class="barcode-scanner-info-text w-100">
                        <span class="barcode-scanner-eyebrow">Scheduled Date</span>
                        <div class="barcode-scanner-select-wrapper mt-1">
                            <input
                                type="datetime-local"
                                name="scheduled_date"
                                class="barcode-scanner-select"
                                t-model="props.picking.scheduled_date"
                            />
                        </div>
                    </div>
                </div>
                <div class="barcode-scanner-info-row mt-3">
                    <div
                        class="barcode-scanner-icon-box-small barcode-scanner-background-purple-light"
                    >
                        <i class="fa fa-sticky-note-o" />
                    </div>
                    <div class="barcode-scanner-info-text w-100">
                        <span class="barcode-scanner-eyebrow">Notes</span>
                        <div class="barcode-scanner-select-wrapper mt-1">
                            <textarea
                                class="barcode-scanner-select"
                                rows="2"
                                placeholder="Add notes..."
                                t-att-value="notePlainText"
                                t-on-input="onNoteInput"
                                style="resize: vertical; min-height: 40px; font-family: inherit;"
                            />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 mb-4">
                <button
                    class="barcode-scanner-button-ghost w-100"
                    t-on-click="() => env.services.barcodeRouter.navigate('main')"
                >
                    Back to Dashboard
                </button>
            </div>
        </div>
    </t>
</templates>

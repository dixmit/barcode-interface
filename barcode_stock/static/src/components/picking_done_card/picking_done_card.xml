<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.PickingDoneCard" owl="1">
        <button
            type="button"
            class="barcode-scanner-picking-card barcode-scanner-picking-done-card"
            t-att-class="props.highlighted ? 'barcode-scanner-picking-card barcode-scanner-picking-done-card is-highlighted' : 'barcode-scanner-picking-card barcode-scanner-picking-done-card'"
            t-on-click="() => props.onDelete(props.line.id)"
            style="border: none; text-align: left; width: 100%; cursor: pointer;"
        >
            <div class="barcode-scanner-picking-card-top">
                <div class="barcode-scanner-picking-card-info">
                    <span
                        class="barcode-scanner-picking-code"
                        style="color: #4caf50;"
                    >Completed</span>
                    <h3 class="barcode-scanner-picking-partner mb-1">
                        <t t-esc="props.line.product_id[1]" />
                    </h3>
                    <span
                        class="barcode-scanner-picking-code"
                        style="color: var(--kw-on-surface-variant); font-weight: normal; font-size: 0.75rem;"
                    >Tap to remove this confirmation</span>
                </div>
                <div class="barcode-scanner-picking-card-status">
                    <span
                        class="barcode-scanner-status-tag barcode-scanner-status-tag-ready"
                        style="background: #e8f5e9; color: #2e7d32;"
                    >
                        <i class="fa fa-check me-1" role="img" aria-label="Done" />
                        <t t-esc="props.line.qty_picked" />
                    </span>
                </div>
            </div>
            <t t-if="props.line.lot_id or props.line.lot_name">
                <hr class="barcode-scanner-divider" />
                <div class="barcode-scanner-picking-card-bottom">
                    <div class="barcode-scanner-picking-meta-left">
                        <i
                            class="fa fa-tag barcode-scanner-meta-icon"
                            style="color: var(--kw-on-surface-variant);"
                        />
                        <span
                            t-if="props.line.lot_id"
                            class="barcode-scanner-meta-text"
                            style="color: var(--kw-on-surface-variant);"
                        >
                            <t t-esc="props.line.lot_id[1]" />
                        </span>
                        <span
                            t-elif="props.line.lot_name"
                            class="barcode-scanner-meta-text"
                            style="color: var(--kw-on-surface-variant);"
                        >
                            <t t-esc="props.line.lot_name" />
                        </span>
                    </div>
                </div>
            </t>
        </button>
    </t>
</templates>

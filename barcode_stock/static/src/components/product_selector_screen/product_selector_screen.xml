<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_scanner.ProductSelectorScreen">
        <div class="barcode-scanner-employee-screen">
            <header class="barcode-scanner-employee-header">
                <button
                    class="barcode-scanner-employee-back-button"
                    t-on-click="goBack"
                >
                    <i class="fa fa-arrow-left" />
                </button>
                <h1 class="barcode-scanner-employee-header-title">Select Product</h1>
                <div style="width: 48px;" />
            </header>

            <main class="barcode-scanner-employee-main">
                <div class="barcode-scanner-employee-search-box">
                    <i class="fa fa-search barcode-scanner-employee-search-icon" />
                    <input
                        type="text"
                        class="barcode-scanner-employee-search-input"
                        placeholder="Search by name or SKU..."
                        t-model="state.search"
                    />
                </div>

                <h2
                    class="barcode-scanner-employee-section-title"
                >AVAILABLE PRODUCTS</h2>
                <div class="barcode-scanner-employee-list">
                    <t t-if="state.loading">
                        <div class="text-center p-4">Loading products...</div>
                    </t>
                    <t t-else="">
                        <t
                            t-foreach="filteredProducts"
                            t-as="product"
                            t-key="product.id"
                        >
                            <div
                                t-att-class="state.selectedProduct?.id === product.id ? 'barcode-scanner-employee-card selected' : 'barcode-scanner-employee-card'"
                                t-on-click="() => this.selectProduct(product)"
                            >
                                <div class="barcode-scanner-employee-avatar-wrapper">
                                    <div class="barcode-scanner-employee-avatar">
                                        <t t-if="product.image_url">
                                            <img
                                                t-att-src="product.image_url"
                                                t-on-error="() => this.onImageError(product)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <div
                                                class="barcode-scanner-employee-avatar-placeholder"
                                            >
                                                <t
                                                    t-esc="product.name.charAt(0).toUpperCase()"
                                                />
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="barcode-scanner-employee-info">
                                    <span class="barcode-scanner-employee-name">
                                        <t t-esc="product.name" />
                                    </span>
                                    <span class="barcode-scanner-employee-role">
                                        <t t-esc="product.default_code || 'No SKU'" />
                                        <span
                                        class="barcode-scanner-employee-dot-separator"
                                    >•</span>
                                        $<t
                                        t-esc="product.standard_price ? product.standard_price.toFixed(2) : '0.00'"
                                    />
                                    </span>
                                </div>
                                <div class="barcode-scanner-employee-status">
                                    <t t-if="state.selectedProduct?.id === product.id">
                                        <i
                                            class="fa fa-check-circle barcode-scanner-employee-icon-selected"
                                        />
                                    </t>
                                    <t t-else="">
                                        <i
                                            class="fa fa-chevron-right barcode-scanner-employee-icon-chevron"
                                        />
                                    </t>
                                </div>
                            </div>
                        </t>
                        <div
                            t-if="filteredProducts.length === 0"
                            class="text-center p-4"
                            style="color: #666;"
                        >No products found.</div>
                    </t>
                </div>
            </main>

            <div
                t-if="state.selectedProduct and props.params?.mode !== 'quick_info_product'"
                style="padding: 0 1rem; margin-bottom: 0.5rem;"
            >
                <div
                    class="barcode-scanner-move-wizard-quantity-row"
                    style="justify-content: center;"
                >
                    <button
                        class="barcode-scanner-move-wizard-quantity-button"
                        t-on-click="decrementQty"
                    >
                        <i class="fa fa-minus" />
                    </button>
                    <input
                        type="number"
                        class="barcode-scanner-move-wizard-quantity-input"
                        t-att-value="state.qty"
                        t-on-input="onQtyInput"
                        min="1"
                        style="max-width: 80px;"
                    />
                    <button
                        class="barcode-scanner-move-wizard-quantity-button"
                        t-on-click="incrementQty"
                    >
                        <i class="fa fa-plus" />
                    </button>
                    <span
                        style="font-size: 0.85rem; color: var(--barcode-scanner-on-surface-variant); font-weight: 500;"
                    >UNITS</span>
                </div>
            </div>

            <footer class="barcode-scanner-employee-footer">
                <button
                    class="barcode-scanner-employee-confirm-button"
                    t-on-click="confirmSelection"
                    t-att-disabled="!state.selectedProduct"
                    t-att-style="!state.selectedProduct ? 'opacity: 0.5; cursor: not-allowed;' : ''"
                >
                    Confirm Product
                </button>
            </footer>
        </div>
    </t>
</templates>
